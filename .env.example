# VideoVault — Environment Variables
# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local

# ── MongoDB ────────────────────────────────────────────────────────────────────
# Connection string to your MongoDB instance
MONGODB_URI=mongodb://localhost:27017

# Database name
MONGODB_DB=videovault

# ── RustFS / S3-compatible Object Storage ──────────────────────────────────────
# Endpoint URL of your S3-compatible store — used for server-side API calls
RUSTFS_ENDPOINT=http://localhost:10000

# Public HTTPS endpoint used when generating presigned URLs (the URL the browser will PUT to).
# In production this must be the externally reachable HTTPS URL (e.g. https://rustfs-api.example.com).
# Leave unset in local dev — falls back to RUSTFS_ENDPOINT automatically.
# RUSTFS_PUBLIC_ENDPOINT=https://rustfs-api.example.com

# Access key for the object storage
RUSTFS_ACCESS_KEY=your-access-key-here

# Secret key for the object storage
RUSTFS_SECRET_KEY=your-secret-key-here

# Bucket name (auto-created on startup if it doesn't exist)
RUSTFS_BUCKET=videos

# ── Authentication ──────────────────────────────────────────────────────────────
# Secret used to sign JWT tokens — use a strong random string (min 32 chars)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-min-32-chars-here
